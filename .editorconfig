# Convenção de formatação do repositório, independente de editor. Sem ela, um arquivo salvo sem
# quebra de linha final (ou com CRLF no Windows) vira diff fantasma a cada máquina diferente.
# VS Code precisa da extensão EditorConfig.EditorConfig (ver .vscode/extensions.json).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Em Markdown, dois espaços no fim da linha são quebra de linha significativa.
[*.md]
trim_trailing_whitespace = false
